# ---------------------------------------------------------------
# Lab for Us Content Hub
# Copy to .env.local for local dev, and set the same keys in Vercel.
# ---------------------------------------------------------------

# --- Supabase (required) ---
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (required before scheduling works) ---
# Any long random string. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# If this is unset the cron endpoints refuse every request.
CRON_SECRET=

# --- Instagram (optional until the Meta app exists) ---
META_APP_ID=
META_APP_SECRET=
# Flip to true only once Meta App Review approves content publishing.
# Until then the Scheduler uses the manual fallback and says so.
INSTAGRAM_PUBLISHING_ENABLED=false

# --- LinkedIn (optional until the LinkedIn app exists) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Flip to true only once Community Management API access is granted.
LINKEDIN_PUBLISHING_ENABLED=false
